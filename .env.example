APP_NAME="GEST-BUDGET CEEAC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (production : mysql) ---
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gest_budget_ceeac
# DB_USERNAME=root
# DB_PASSWORD=

# --- Session & cache (production : redis recommandé — P2-2) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# Cockpit live (P3-7 — drill-down + WebSocket)
COCKPIT_LIVE_ENABLED=true
COCKPIT_LIVE_POLL_SECONDS=15

# Laravel Reverb (prod — BROADCAST_CONNECTION=reverb)
REVERB_ENABLED=false
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Redis (production CEEAC) ---
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis_failover
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# QUEUE_REPORTING=reporting
# QUEUE_NOTIFICATIONS=notifications
# QUEUE_WEBHOOKS=webhooks
# Worker : php artisan queue:work redis --queue=reporting,notifications,webhooks,default --tries=3

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Courriel ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ceeac.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum / API (I-P1) ---
# Durée de vie des jetons Bearer en minutes (défaut : 480 = 8 h).
SANCTUM_TOKEN_EXPIRATION_MINUTES=480
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
# SANCTUM_TOKEN_PREFIX=

# Limites de débit API (voir AppServiceProvider + routes/api.php)
API_TOKEN_RATE_LIMIT=10
API_RATE_LIMIT=120

# Webhooks interop (I-P2)
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT=10

# --- MFA / TOTP (P1-1) ---
MFA_ENABLED=true
MFA_REQUIRED_ROLES=administrateur,secretaire_general,controleur_financier,commissaire
MFA_RECOVERY_CODES_COUNT=8
MFA_DEMO_CODE=123456

# --- GED ---
GED_TAILLE_MAX_MO=10
GED_ANTIVIRUS_ACTIF=false
GED_ANTIVIRUS_DRIVER=null
# GED_ANTIVIRUS_DRIVER=clamav
# GED_CLAMSCAN_PATH=clamscan
GED_ANTIVIRUS_QUARANTINE=true
GED_OCR_ACTIF=false
GED_OCR_DRIVER=basique
# GED_TESSERACT_PATH=tesseract
GED_SIGNATURE_PROVIDER=interne
# GED_SIGNATURE_API_URL=
# GED_SIGNATURE_API_KEY=
# GED_SIGNATURE_NIVEAU=qualifiee
GED_NOTIFICATIONS_MAIL=false
GED_EXPIRATION_ALERTE_JOURS=30

# --- Notifications métier ---
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_EMAIL_QUEUE=true
NOTIFICATIONS_EMAIL_MAX_TRIES=3
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_SMS_PROVIDER=log
NOTIFICATIONS_SMS_MAX_TRIES=3
NOTIFICATIONS_ESCALADE_DELAI_HEURES=24
NOTIFICATIONS_PURGE_ARCHIVES_JOURS=365
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# --- Workflow & gouvernance ---
WORKFLOW_SOD_ENABLED=true
WORKFLOW_SOD_CREATOR_CANNOT_VALIDATE=true
WORKFLOW_SOD_INCOMPATIBLE_ROLES_ENABLED=true
WORKFLOW_DELAI_DEFAUT_JOURS=5
WORKFLOW_RELANCE_INTERVALLE_JOURS=3

# --- Rétention journaux d'audit (P2-4) ---
AUDIT_PURGE_ENABLED=true
AUDIT_PURGE_MIN_JOURS=90
AUDIT_PURGE_BATCH_SIZE=5000
AUDIT_RETENTION_JOURNAUX_JOURS=2555
AUDIT_RETENTION_WORKFLOW_JOURS=2555
AUDIT_RETENTION_LOGIN_JOURS=365
AUDIT_RETENTION_API_JOURS=365
AUDIT_RETENTION_DEPENSES_JOURS=1825
AUDIT_RETENTION_REPORTING_JOURS=1825
AUDIT_RETENTION_NOTIFICATIONS_JOURS=365
AUDIT_RETENTION_SUIVI_PHYSIQUE_JOURS=1825
AUDIT_RETENTION_GED_JOURS=2555

# --- Contrôle d'intégrité des données (P2-10) ---
DATA_INTEGRITY_ENABLED=true
DATA_INTEGRITY_SEUIL=warning

# --- Reporting planifié ---
REPORTING_GED_AUTO_INDEX=true
REPORTING_ASYNC_ENABLED=true
REPORTING_SCHEDULE_ENABLED=true
REPORTING_SCHEDULE_TRIMESTRIEL=true
REPORTING_SCHEDULE_SEMESTRIEL=true
REPORTING_SCHEDULE_ANNUEL=true

# --- Suivi physique / IOV ---
SUIVI_JUSTIFICATIF_OBLIGATOIRE=true
SUIVI_SYNC_TACHES_AUTO=true

# --- Charte graphique CEEAC (P3-8) ---
# CHARTE_COULEUR_PRIMAIRE=#0a4a8f
# CHARTE_COULEUR_FONCE=#073564
# CHARTE_INSTITUTION="COMMISSION DE LA CEEAC"

# --- Sécurité HTTP / CSP (P3-4) ---
APP_SECURITY_HEADERS=true
CSP_ENABLED=true
# standard | strict
CSP_MODE=standard
# Surveillance parallèle (Report-Only, sans blocage)
CSP_REPORT_ONLY=false
# CSP_REPORT_URI=/csp-report
CSP_VITE_DEV=true
HSTS_ENABLED=true
